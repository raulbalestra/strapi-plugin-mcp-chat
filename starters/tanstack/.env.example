# URL pública do Strapi (lida no cliente via import.meta.env)
VITE_STRAPI_URL=http://localhost:1337

# Token de API do Strapi — opcional, só usado no servidor (loaders / server functions).
# Necessário se as content-types não forem públicas.
STRAPI_API_TOKEN=

# Segredo de preview — compartilhado com o admin do Strapi para validar /api/preview.
PREVIEW_SECRET=troque-isto
