# URL pública do Strapi (acessível pelo navegador). Sem barra final.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Token de API do Strapi (somente servidor). Opcional: necessário apenas
# para ler conteúdo protegido ou rascunhos (Draft Mode).
STRAPI_API_TOKEN=

# Segredo compartilhado com o Strapi para ativar o Preview / Draft Mode.
# Deve ser igual ao valor configurado no admin do Strapi.
PREVIEW_SECRET=troque-isto
